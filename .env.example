# LLM Provider: "ollama" or "foundry"
VITE_LLM_PROVIDER=ollama

# Ollama LLM endpoint (default: local)
VITE_OLLAMA_URL=http://localhost:<<PORT>>

# Ollama model for command parsing (small model recommended for speed)
# Options: phi4-mini, qwen2.5:1.5b, gemma3:1b, llama3.2:1b
VITE_OLLAMA_MODEL=<<MODEL_NAME>>

# Foundry Local endpoint and model (used when VITE_LLM_PROVIDER=foundry)
# Start Foundry Local and load a model first: foundry model run <model-alias>
VITE_FOUNDRY_URL=http://localhost:<<PORT>>
VITE_FOUNDRY_MODEL=<<MODEL_NAME>>

# Sherpa-ONNX WASM script (ES module, placed in public/sherpa-onnx/)
VITE_SHERPA_SCRIPT_URL=/sherpa-onnx/sherpa-onnx-streaming-asr.js

# Model file paths (placed in public/models/)
VITE_MODEL_ENCODER_URL=/models/encoder-epoch-99-avg-1.int8.onnx
VITE_MODEL_DECODER_URL=/models/decoder-epoch-99-avg-1.int8.onnx
VITE_MODEL_JOINER_URL=/models/joiner-epoch-99-avg-1.int8.onnx
VITE_MODEL_TOKENS_URL=/models/tokens.txt

# ASR settings
VITE_ASR_SAMPLE_RATE=16000
VITE_ASR_NUM_THREADS=2
